# ============================================================
# MEXC TRADE — Environment Variables Template
# Copy this file to .env and fill in your actual credentials
# ============================================================

# ─── DATABASE (PostgreSQL) ───
# Get from: Neon.tech (recommended), Supabase, or your own PostgreSQL server
DATABASE_URL="postgresql://username:password@host/database?sslmode=require"

# ─── AUTHENTICATION ───
# Generate a strong random 64+ character string
# Example generator: https://randomkeygen.com/
JWT_SECRET="REPLACE_WITH_A_NEW_RANDOM_SECRET_AT_LEAST_64_CHARACTERS"
JWT_EXPIRES_IN="7d"

# ─── ADMIN ACCOUNT (Created via seed script) ───
# Choose your admin email and a strong password (min 8 chars, uppercase, lowercase, number, special char)
ADMIN_EMAIL="REPLACE_WITH_YOUR_ADMIN_EMAIL"
ADMIN_PASSWORD="REPLACE_WITH_A_UNIQUE_STRONG_PASSWORD"

# ─── APP CONFIG ───
# Your production URL (or localhost for development)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── CLOUDINARY (File Uploads) ───
# Sign up at: https://cloudinary.com (free tier: 25 GB)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Safety: money-moving API endpoints are hard-blocked in code for demo/paper trading.
DEMO_MODE=true
